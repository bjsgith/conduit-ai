@model LeadListViewModel
@{
    ViewData["Title"] = "Leads";
}

<div class="page-head">
    <div>
        <h1>Leads</h1>
        <span class="count-chip">@Model.TotalCount @(Model.TotalCount == 1 ? "lead" : "leads")@(Model.Filter.HasAnyFilter ? " match your filters" : "")</span>
    </div>
    <a class="btn btn-primary" asp-controller="Leads" asp-action="Create">+ New Lead</a>
</div>

<form method="get" asp-controller="Leads" asp-action="Index" class="filterbar">
    <input type="hidden" name="Filter.Page" value="1" />
    <div class="field">
        <label asp-for="Filter.Search">Search</label>
        <input asp-for="Filter.Search" placeholder="Name, email, notes…" />
    </div>
    <div class="field">
        <label asp-for="Filter.Status">Status</label>
        <select asp-for="Filter.Status" asp-items="Html.GetEnumSelectList<LeadStatus>()">
            <option value="">All</option>
        </select>
    </div>
    <div class="field">
        <label asp-for="Filter.LeadSource">Source</label>
        <select asp-for="Filter.LeadSource" asp-items="Html.GetEnumSelectList<LeadSource>()">
            <option value="">All</option>
        </select>
    </div>
    <div class="field">
        <label asp-for="Filter.MinLeadScore">Min Score</label>
        <input asp-for="Filter.MinLeadScore" type="number" min="0" max="100" placeholder="0" />
    </div>
    <div class="field">
        <label asp-for="Filter.Location">Location</label>
        <input asp-for="Filter.Location" placeholder="e.g. Scottsdale" />
    </div>
    <div class="field" style="flex-direction:row; gap:8px; align-items:end;">
        <button type="submit" class="btn btn-primary">Filter</button>
        @if (Model.Filter.HasAnyFilter)
        {
            <a class="btn btn-ghost" asp-controller="Leads" asp-action="Index">Clear</a>
        }
    </div>
</form>

<section class="card">
    @await Html.PartialAsync("_LeadTable", Model.Leads)
</section>

@if (Model.TotalPages > 1)
{
    <nav class="pagination" aria-label="Lead result pages">
        <form method="get" asp-controller="Leads" asp-action="Index">
            <input type="hidden" name="Filter.Search" value="@Model.Filter.Search" />
            <input type="hidden" name="Filter.Status" value="@Model.Filter.Status" />
            <input type="hidden" name="Filter.LeadSource" value="@Model.Filter.LeadSource" />
            <input type="hidden" name="Filter.MinLeadScore" value="@Model.Filter.MinLeadScore" />
            <input type="hidden" name="Filter.Location" value="@Model.Filter.Location" />
            <button class="btn btn-sm" type="submit" name="Filter.Page" value="@(Model.Filter.Page - 1)" disabled="@(Model.Filter.Page <= 1)">Previous</button>
            <span aria-live="polite">Page @Model.Filter.Page of @Model.TotalPages</span>
            <button class="btn btn-sm" type="submit" name="Filter.Page" value="@(Model.Filter.Page + 1)" disabled="@(Model.Filter.Page >= Model.TotalPages)">Next</button>
        </form>
    </nav>
}
